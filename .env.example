# Общие настройки
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# PostgreSQL
DB_NAME=budgetkeeper
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=127.0.0.1
DB_PORT=5432

# Почта: на учебном стенде письма выводятся в консоль runserver
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@budgetkeeper.local

# Для реальной отправки через SMTP (Mail.ru / Яндекс) задайте
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend и заполните:
EMAIL_HOST=smtp.mail.ru
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=your_email@mail.ru
# ВНИМАНИЕ: нужен «пароль приложения», а не пароль от почтового ящика!
EMAIL_HOST_PASSWORD=

# Необязательно: ИИ-категоризация через OpenAI-совместимый API.
# Без ключа работает локальный классификатор по ключевым словам.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
